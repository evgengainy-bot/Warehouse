<Window x:Class="Warehouse.Views.WhModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Склад" Height="200" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Наименование склада:"/>
        <TextBox x:Name="tbName" Grid.Row="1" Margin="0 0 0 8"
                 KeyDown="TextBox_KeyDown"/>

        <Label Grid.Row="2" Content="Адрес:"/>
        <TextBox x:Name="tbAddress" Grid.Row="3" Margin="0 0 0 10"
                 KeyDown="TextBox_KeyDown"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="90" Click="BtnOk_Click" Margin="0 0 8 0"/>
            <Button Content="Отмена" Width="90" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>