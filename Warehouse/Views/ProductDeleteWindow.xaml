<Window x:Class="Warehouse.Views.ProductDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление товара" Height="200" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0 0 0 4"
                   Text="Для подтверждения удаления введите наименование товара:"/>

        <TextBlock Grid.Row="1" FontWeight="Bold" Margin="0 0 0 8"
                   x:Name="tbProductName" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2" Foreground="Gray" FontSize="11"
                   Margin="0 0 0 4"
                   Text="(Артикул, категория и все данные товара будут удалены)"/>

        <TextBox x:Name="tbInput" Grid.Row="3" Margin="0 0 0 10"
                 KeyDown="tbInput_KeyDown"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Удалить" Width="90" Click="BtnDelete_Click"
                    Margin="0 0 8 0" Background="#FFCCCC"/>
            <Button Content="Отмена" Width="90" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>