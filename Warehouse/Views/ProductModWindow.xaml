<Window x:Class="Warehouse.Views.ProductModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="520" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Наименование:"/>
        <TextBox x:Name="tbName" Grid.Row="0" Grid.Column="1" Margin="0 2"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Единица изм.:"/>
        <ComboBox x:Name="cmbUnit" Grid.Row="1" Grid.Column="1" Margin="0 2"
                  IsEditable="True">
            <ComboBoxItem Content="шт"/>
            <ComboBoxItem Content="кг"/>
            <ComboBoxItem Content="л"/>
            <ComboBoxItem Content="м"/>
            <ComboBoxItem Content="уп"/>
            <ComboBoxItem Content="пара"/>
        </ComboBox>

        <Label Grid.Row="2" Grid.Column="0" Content="Цена:"/>
        <TextBox x:Name="tbPrice" Grid.Row="2" Grid.Column="1" Margin="0 2"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Категория:"/>
        <Grid Grid.Row="3" Grid.Column="1" Margin="0 2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="cmbCategory" Grid.Column="0"
                      DisplayMemberPath="Name"/>
            <Button Grid.Column="1" Content="+ Новая" Width="70"
                    Margin="4 0 0 0" Click="BtnNewCategory_Click"/>
        </Grid>

        <Label Grid.Row="4" Grid.Column="0" Content="Производитель:"/>
        <Grid Grid.Row="4" Grid.Column="1" Margin="0 2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="cmbManufacturer" Grid.Column="0"
                      DisplayMemberPath="Name"/>
            <Button Grid.Column="1" Content="+ Новый" Width="70"
                    Margin="4 0 0 0" Click="BtnNewManufacturer_Click"/>
        </Grid>

        <Label Grid.Row="5" Grid.Column="0" Content="Поставщик:"/>
        <Grid Grid.Row="5" Grid.Column="1" Margin="0 2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="cmbSupplier" Grid.Column="0"
                      DisplayMemberPath="Name"/>
            <Button Grid.Column="1" Content="+ Новый" Width="70"
                    Margin="4 0 0 0" Click="BtnNewSupplier_Click"/>
        </Grid>

        <Label Grid.Row="6" Grid.Column="0" Content="Скидка %:"/>
        <TextBox x:Name="tbDiscount" Grid.Row="6" Grid.Column="1"
                 Margin="0 2" Text="0"/>

        <Label Grid.Row="7" Grid.Column="0" Content="Описание:"/>
        <TextBox x:Name="tbDescription" Grid.Row="7" Grid.Column="1"
                 Margin="0 2" Height="50" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <Label Grid.Row="8" Grid.Column="0" Content="Фото:"/>
        <Grid Grid.Row="8" Grid.Column="1" Margin="0 2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="tbPhoto" Grid.Column="0"
                     IsReadOnly="True" Background="#F8F8F8"
                     VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Обзор..." Width="70"
                    Margin="4 0 0 0" Click="BtnBrowsePhoto_Click"/>
        </Grid>

        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Margin="0 6 0 0">
            <Image x:Name="imgPreview" Width="70" Height="70"
                   Stretch="Uniform" Margin="0 0 10 0"/>
            <TextBlock Text="Предпросмотр" VerticalAlignment="Center"
                       Foreground="Gray" FontSize="11"/>
        </StackPanel>

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0 8 0 0">
            <Button Content="OK" Width="90" Click="BtnOk_Click" Margin="0 0 8 0"/>
            <Button Content="Отмена" Width="90" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>