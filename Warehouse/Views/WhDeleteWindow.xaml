<Window x:Class="Warehouse.Views.WhDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление склада" Height="180" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0 0 0 8"
                   Text="Для подтверждения удаления введите название склада:"/>

        <TextBlock Grid.Row="1" FontWeight="Bold" Margin="0 0 0 8"
                   x:Name="tbWhName"/>

        <TextBox x:Name="tbInput" Grid.Row="2" Margin="0 0 0 10"
                 KeyDown="tbInput_KeyDown"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Удалить" Width="90" Click="BtnDelete_Click"
                    Margin="0 0 8 0" Background="#FFCCCC"/>
            <Button Content="Отмена" Width="90" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>