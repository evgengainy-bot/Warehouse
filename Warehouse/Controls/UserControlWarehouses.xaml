<UserControl x:Class="Warehouse.Controls.UserControlWarehouses"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Warehouse"
             xmlns:helpers="clr-namespace:Warehouse.Controls.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="999">

    <UserControl.Resources>
        <DataTemplate x:Key="WhListTemplate">
            <StackPanel Margin="4">
                <TextBlock FontFamily="Verdana" FontSize="13"
                           Text="{Binding WhName}"
                           HorizontalAlignment="Left"/>
                <TextBlock FontFamily="Verdana" FontSize="11"
                           Text="{Binding WhAddress}"
                           Foreground="Gray"
                           HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>
        <helpers:PriceConverter x:Key="PriceConv"/>
        <helpers:DiscountBackgroundConverter x:Key="BgConv"/>
    </UserControl.Resources>

    <UserControl.CommandBindings>
        <CommandBinding Command="local:WindowCommands.WhAdd"
                        Executed="WhAdd_Executed"/>
        <CommandBinding Command="local:WindowCommands.WhEdit"
                        Executed="WhEdit_Executed"/>
        <CommandBinding Command="local:WindowCommands.WhDelete"
                        Executed="WhDelete_Executed"/>
    </UserControl.CommandBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">

            
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4">
                <Button Content="Добавить" Width="70" Height="22" FontSize="11"
                Command="local:WindowCommands.WhAdd"/>
                <Button Content="Изменить" Width="70" Height="22" FontSize="11"
                Command="local:WindowCommands.WhEdit"/>
                <Button Content="Удалить" Width="70" Height="22" FontSize="11"
                Command="local:WindowCommands.WhDelete"/>
            </StackPanel>

            <Label DockPanel.Dock="Top" Content="Склады:"
           FontWeight="Bold" Margin="4 4 4 0"/>

            <ListBox x:Name="lbxWhList"
             ItemTemplate="{StaticResource WhListTemplate}"
             SelectionChanged="lbxWhList_SelectionChanged"
             Margin="4">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Новый склад"
                          Command="local:WindowCommands.WhAdd"/>
                        <MenuItem Header="Изменить склад"
                          Command="local:WindowCommands.WhEdit"/>
                        <Separator/>
                        <MenuItem Header="Удалить склад"
                          Command="local:WindowCommands.WhDelete"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

        </DockPanel>

        <GridSplitter Grid.Column="1"
                      ShowsPreview="False"
                      Width="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="#C0C0C0"/>

        <DockPanel Grid.Column="2" Margin="4">

            <Label x:Name="lblWhName" DockPanel.Dock="Top"
                   Content="Выберите склад"
                   FontWeight="Bold" Margin="0 4 0 4"/>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 6">
                <TextBlock Text="Поиск: " VerticalAlignment="Center" Margin="0 0 4 0"/>
                <TextBox x:Name="TxtSearch" Width="200"
             TextChanged="TxtSearch_TextChanged"
             Margin="0 0 8 0"/>
                <TextBlock Text="Поставщик: " VerticalAlignment="Center" Margin="0 0 4 0"/>
                <ComboBox x:Name="CmbSupplier" Width="140"
              SelectionChanged="CmbSupplier_SelectionChanged"
              Margin="0 0 8 0"/>
                <TextBlock Text="Сортировка: " VerticalAlignment="Center" Margin="0 0 4 0"/>
                <ComboBox x:Name="CmbSort" Width="130"
              SelectionChanged="CmbSort_SelectionChanged">
                    <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                    <ComboBoxItem Content="Остаток ↑"/>
                    <ComboBoxItem Content="Остаток ↓"/>
                    <ComboBoxItem Content="Цена ↑"/>
                    <ComboBoxItem Content="Цена ↓"/>
                </ComboBox>
            </StackPanel>

            <DataGrid x:Name="DgProducts"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          SelectionMode="Single"
          CanUserSortColumns="True"
          ColumnHeaderHeight="30"
          MouseDoubleClick="DgProducts_MouseDoubleClick">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background"
                    Value="{Binding Converter={StaticResource BgConv}}"/>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="Фото" Width="60" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding PhotoPath}"
                           Width="50" Height="50" Stretch="Uniform"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Наименование"
                            Binding="{Binding Name}"
                            Width="*"
                            MinWidth="120"
                            SortMemberPath="Name"/>

                    <DataGridTextColumn Header="Категория"
                            Binding="{Binding Category.Name}"
                            Width="110"
                            MinWidth="80"
                            SortMemberPath="Category.Name"/>

                    <DataGridTextColumn Header="Производитель"
                            Binding="{Binding Manufacturer.Name}"
                            Width="120"
                            MinWidth="100"
                            SortMemberPath="Manufacturer.Name"/>

                    <DataGridTextColumn Header="Поставщик"
                            Binding="{Binding Supplier.Name}"
                            Width="110"
                            MinWidth="80"
                            SortMemberPath="Supplier.Name"/>

                    <DataGridTemplateColumn Header="Цена" Width="110"
                                MinWidth="80"
                                SortMemberPath="Price">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Price, StringFormat='{}{0:N2} руб.'}"
                               TextAlignment="Right" Padding="4 0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Остаток"
                            Binding="{Binding StockQuantity}"
                            Width="70"
                            MinWidth="60"
                            SortMemberPath="StockQuantity"/>

                    <DataGridTextColumn Header="Скидка %"
                            Binding="{Binding DiscountPercent}"
                            Width="70"
                            MinWidth="65"
                            SortMemberPath="DiscountPercent"/>

                </DataGrid.Columns>
            </DataGrid>

        </DockPanel>
    </Grid>
</UserControl>