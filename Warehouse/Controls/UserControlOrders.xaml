<UserControl x:Class="Warehouse.Controls.UserControlOrders"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900">

    <DockPanel Margin="8">

        <Label DockPanel.Dock="Top" Content="Журнал накладных"
           FontSize="14" FontWeight="Bold" Margin="0 0 0 4"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 6">
            <TextBlock Text="Склад: " VerticalAlignment="Center" Margin="0 0 4 0"/>
            <ComboBox x:Name="CmbWarehouse" Width="220"
                  DisplayMemberPath="WhName"
                  SelectionChanged="CmbWarehouse_SelectionChanged"
                  Margin="0 0 8 0"/>
            <Button Content="Удалить накладную" Click="BtnDelete_Click"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="DgOrders"
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="DgOrders_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№"
                                    Binding="{Binding OrderId}" Width="50"/>
                    <DataGridTextColumn Header="Дата"
                                    Binding="{Binding OrderDate,
                                    StringFormat='dd.MM.yyyy HH:mm'}" Width="130"/>
                    <DataGridTextColumn Header="Тип"
                                    Binding="{Binding OrderTypeDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Склад"
                                    Binding="{Binding Warehouse.WhName}" Width="160"/>
                    <DataGridTextColumn Header="Позиций"
                                    Binding="{Binding Items.Count}" Width="70"/>
                    <DataGridTemplateColumn Header="Сумма" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalSum,
                                       StringFormat='{}{0:N2} руб.'}"
                                       TextAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Комментарий"
                                    Binding="{Binding Comment}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Label Grid.Row="1" Content="Состав накладной:"
               FontWeight="Bold" Margin="0 4 0 2"/>

            <DataGrid x:Name="DgOrderItems"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Наименование"
                                    Binding="{Binding Product.Name}" Width="*"/>
                    <DataGridTextColumn Header="Кол-во"
                                    Binding="{Binding Quantity}" Width="70"/>
                    <DataGridTextColumn Header="Ед.изм."
                                    Binding="{Binding Product.Unit}" Width="60"/>
                    <DataGridTemplateColumn Header="Цена" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PriceAtMoment,
                                       StringFormat='{}{0:N2} руб.'}"
                                       TextAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>